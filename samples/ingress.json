{
  "apiVersion": "v1",
  "items": [
    {
      "metadata": {
        "name": "shop-ingress",
        "namespace": "team-a",
        "annotations": {
          "appgw.ingress.kubernetes.io/rule-priority": "100"
        }
      },
      "spec": {
        "ingressClassName": "azure-application-gateway",
        "rules": [
          {
            "host": "app.example.com",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "backend": { "service": { "name": "frontend" } }
                },
                {
                  "path": "/api",
                  "backend": { "service": { "name": "api" } }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "metadata": {
        "name": "shared-ingress",
        "namespace": "team-b",
        "annotations": {}
      },
      "spec": {
        "ingressClassName": "azure-application-gateway",
        "rules": [
          {
            "host": "app.example.com",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "backend": { "service": { "name": "other-frontend" } }
                }
              ]
            }
          },
          {
            "host": "*.example.com",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "backend": { "service": { "name": "wildcard-backend" } }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
